# Postgres connection (docker compose sets this for the web container automatically)
DATABASE_URL=postgres://arena:arena@localhost:5439/arena

# GitHub personal access token (classic or fine-grained, public_repo read is enough).
# Without it the GitHub search API allows only 10 requests/min, so syncing will be slow.
GITHUB_TOKEN=

# Only count contributions since this date (ISO). Leave empty to default to 2000-01-01.
SYNC_SINCE=2000-01-01

# Set to "true" to also count PRs/issues on repos the member owns themselves.
INCLUDE_OWN_REPOS=false

# Require new members (by GitHub username) to belong to these GitHub organizations,
# comma-separated (e.g. org1,org2) — any one is enough. Registration is rejected for
# non-members, syncs re-check and flag departures, and members still in any listed
# org cannot be deleted. Leave empty to disable the organization guard and allow anyone.
REQUIRED_ORG=

# Host port Postgres is exposed on by docker compose (5432 is often taken locally).
DB_PORT=5439

# Office timezone for "this week" / "this month" boundaries and day streaks (IANA name).
# Named APP_TZ rather than TZ because Vercel reserves TZ and pins functions to UTC,
# so it cannot be set there. The app applies this explicitly and never relies on the
# process timezone, so it works the same self-hosted and on serverless.
APP_TZ=Asia/Dhaka

# Public URL of the deployment, used for metadata and link previews.
SITE_URL=http://localhost:3000

# Hour (0-23, in APP_TZ) at which the nightly sync runs. Docker compose only —
# on Vercel the schedule lives in vercel.json and is expressed in UTC.
SYNC_HOUR=2

# Shared secret for the scheduled sync endpoint. When set, GET /api/sync requires
# `Authorization: Bearer <secret>`, so a public deployment cannot be made to sync
# by anyone who finds the URL. Vercel Cron sends this header automatically once
# CRON_SECRET is added to the project's environment variables.
CRON_SECRET=
